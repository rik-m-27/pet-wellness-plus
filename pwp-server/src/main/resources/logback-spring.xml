<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <timestamp key="bySecond" datePattern="yyyyMMdd'T'HHmmss"/>

    <property name="LOG_PATH" value="./logs" />
    <property name="ARCHIVE_PATH" value="${LOG_PATH}/archive" />
    <property name="LOG_FILE_NAME" value="pet-wellness-plus" />

    <appender name="ROLLING_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">

        <!-- New file on every restart -->
        <file>${LOG_PATH}/${LOG_FILE_NAME}.log</file>

		<rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
		    <fileNamePattern>
		        ${ARCHIVE_PATH}/%d{yyyy-MM-dd}/${bySecond}-${LOG_FILE_NAME}.%i.log
		    </fileNamePattern>
		
		    <maxFileSize>10MB</maxFileSize>
		    <maxHistory>30</maxHistory>
		    <totalSizeCap>1GB</totalSizeCap>
		    <cleanHistoryOnStart>true</cleanHistoryOnStart>
		</rollingPolicy>

        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="ROLLING_FILE" />
    </root>

    <logger name="com.petwellnessplus" level="DEBUG" additivity="false">
        <appender-ref ref="ROLLING_FILE" />
    </logger>

</configuration>
